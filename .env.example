# GOLD BOT - Environment Configuration
# Copy this file to .env and enter your local settings.
# Never commit .env to GitHub.

# Application
APP_NAME=GOLD_BOT
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Trading safety
BOT_MODE=ANALYSIS_ONLY
TRADING_ENABLED=false
LIVE_TRADING_AUTHORIZED=false
EMERGENCY_STOP=true

# MetaTrader 5 connection
MT5_ENABLED=false
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=10000

# Market configuration
MT5_SYMBOL=
DEFAULT_TIMEFRAME=M5

# Risk safety defaults
MAX_RISK_PER_TRADE_PERCENT=0.5
MAX_DAILY_LOSS_PERCENT=2.0
MAX_OPEN_POSITIONS=1

# API security
API_AUTH_ENABLED=true
API_ACCESS_TOKEN=

# Database
DATABASE_URL=sqlite:///./data/gold_bot.db

# Time settings
APP_TIMEZONE=Asia/Baghdad
